GROQ_API_KEY=your_groq_api_key_here

# Primary model (default). Requires a paid/developer Groq tier.
# See: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback model — used automatically if the primary model is unavailable
# on your API key tier. Available on all Groq tiers including free.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
